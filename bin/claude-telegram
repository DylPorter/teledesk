#!/usr/bin/env bash
# claude-telegram code [claude args…] | desk-channel. Works from anywhere once bin/ is on PATH (or symlinked).
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)" || exit 1
export NODE_OPTIONS="${NODE_OPTIONS:+$NODE_OPTIONS }--no-warnings=ExperimentalWarning"
exec node "$DIR/node_modules/tsx/dist/cli.mjs" "$DIR/src/cli.ts" "$@"

# teledesk reads exactly these variables (the last two are optional).

# A fresh bot from @BotFather. One bot token can be polled by only ONE program —
# never share a token between people, machines, or with the retired legacy bot.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user id; ONLY this account can drive sessions.
# @userinfobot tells you yours.
TELEGRAM_ALLOWED_USER_ID=

# Optional: close gone sessions' topics after this many days without activity (default 7).
# Closing is a soft, reversible hide: /desk in that folder reopens the very same topic.
# DESK_TOPIC_TTL_DAYS=7

# Optional: state folder (default ~/.local/share/teledesk; $XDG_DATA_HOME is respected).
# TELEDESK_DATA_DIR=

# Other folders in this repo (signal-brief/, hk-events/, job-sift/, legacy/) use their
# own configuration — see each folder's README. legacy/ is the retired v1 bot.

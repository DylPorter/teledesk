# claude-telegram daemon: your Claude Code sessions in Telegram topics.
# Install (user unit): copy to ~/.config/systemd/user/, set WorkingDirectory to your clone,
# then: systemctl --user daemon-reload && systemctl --user enable --now claude-telegram
# Reads TELEGRAM_BOT_TOKEN and TELEGRAM_ALLOWED_USER_ID from .env in WorkingDirectory.
[Unit]
Description=claude-telegram: Claude Code sessions in Telegram topics
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/claude-telegram
ExecStart=/usr/bin/env node --no-warnings=ExperimentalWarning --import tsx src/index.ts
Restart=on-failure
RestartSec=5
# 78: bad .env or a rejected bot token; restarting won't fix it.
RestartPreventExitStatus=78
Environment=TSX_DISABLE_CACHE=1
# Stopping it doesn't end open sessions: they reconnect when it's back.
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
